// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  games               UserGame[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserGame {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int      @map("user_id")
  igdbGameId String   @map("igdb_game_id")
  status     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("user_games")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Game {
  id               Int       @id
  name             String
  slug             String    @unique
  coverUrl         String?   @map("cover_url")
  summary          String?
  releaseDate      DateTime? @map("release_date")
  totalRating      Float?    @map("total_rating")
  totalRatingCount Int?      @map("total_rating_count")
  gameTypeId       Int       @map("game_type_id")
  baseGameId       Int?      @map("base_game_id")
  esrbRating       String?   @map("esrb_rating")
  esrbThumbnail    String?   @map("esrb_thumbnail")
  esrbDescriptions String[]  @default([]) @map("esrb_descriptions")
  developers       String[]  @default([])
  publishers       String[]  @default([])
  igdbChecksum     String    @map("igdb_checksum")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  genres      Genre[]      @relation("GameGenre")
  themes      Theme[]      @relation("GameTheme")
  platforms   Platform[]   @relation("GamePlatform")
  collections Collection[] @relation("GameCollection")
  franchises  Franchise[]  @relation("GameFranchise")

  baseGame       Game?  @relation("GameVariant", fields: [baseGameId], references: [id])
  relatedContent Game[] @relation("GameVariant")

  similarTo   Game[] @relation("SimilarGames")
  similarFrom Game[] @relation("SimilarGames")

  gameType GameType @relation(fields: [gameTypeId], references: [id])

  @@map("games")
}

model GameType {
  id           Int      @id
  label        String
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  Game Game[]

  @@map("game_types")
}

model Genre {
  id           Int      @id
  name         String   @unique
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameGenre")

  @@map("genres")
}

model Theme {
  id           Int      @id
  name         String   @unique
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameTheme")

  @@map("themes")
}

model Platform {
  id               Int      @id
  name             String   @unique
  abbreviation     String
  platformFamilyId Int      @map("platform_family_id")
  igdbChecksum     String   @unique @map("igdb_checksum")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  platformFamily PlatformFamily @relation(fields: [platformFamilyId], references: [id])

  games Game[] @relation("GamePlatform")

  @@map("platforms")
}

model PlatformFamily {
  id           Int      @id
  name         String
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  platforms Platform[]

  @@map("platform_families")
}

model Collection {
  id           Int      @id
  name         String
  igdbChecksum String   @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameCollection")

  @@map("collections")
}

model Franchise {
  id           Int      @id
  name         String
  igdbChecksum String   @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameFranchise")

  @@map("franchises")
}
