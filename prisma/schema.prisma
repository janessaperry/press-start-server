// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model IgdbToken {
  id          Int      @id @default(autoincrement())
  accessToken String   @map("access_token")
  expiresIn   Int      @map("expires_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("igdb_token")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  games               UserGame[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserGame {
  id                Int            @id @default(autoincrement())
  userId            Int            @map("user_id")
  igdbGameId        Int            @map("igdb_game_id")
  libraryStatus     LibraryStatus? @map("library_status")
  libraryPlatformId Int?           @map("library_platform_id")
  libraryFormat     LibraryFormat? @map("library_format")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameDetails     Game      @relation(fields: [igdbGameId], references: [id])
  libraryPlatform Platform? @relation(fields: [libraryPlatformId], references: [id])

  @@unique(name: "userIdGameId", [userId, igdbGameId])
  @@map("user_games")
}

enum LibraryStatus {
  WANT_TO_PLAY
  PLAYING
  PLAYED
  ON_PAUSE
  PLAY_ANYTIME
  WISHLIST
}

enum LibraryFormat {
  DIGITAL
  PHYSICAL
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model Game {
  id               Int       @id
  name             String
  slug             String    @unique
  coverId          String?   @map("cover_id")
  summary          String?
  releaseDate      DateTime? @map("release_date")
  totalRating      Float?    @map("total_rating")
  totalRatingCount Int?      @map("total_rating_count")
  esrbRating       String?   @map("esrb_rating")
  esrbThumbnailId  String?   @map("esrb_thumbnail_id")
  esrbDescriptions String[]  @default([]) @map("esrb_descriptions")
  developers       String[]  @default([])
  publishers       String[]  @default([])
  screenshotIds    String[]  @default([]) @map("screenshot_ids")
  igdbChecksum     String    @map("igdb_checksum")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  userGames UserGame[]

  gameTypeId Int      @map("game_type_id")
  gameType   GameType @relation(fields: [gameTypeId], references: [id])

  baseGameId     Int?   @map("base_game_id")
  baseGame       Game?  @relation("GameVariant", fields: [baseGameId], references: [id])
  relatedContent Game[] @relation("GameVariant")

  genres      Genre[]      @relation("GameGenre")
  themes      Theme[]      @relation("GameTheme")
  platforms   Platform[]   @relation("GamePlatform")
  collections Collection[] @relation("GameCollection")
  franchises  Franchise[]  @relation("GameFranchise")

  timeToBeat TimeToBeat?

  similarTo   Game[] @relation("SimilarGames")
  similarFrom Game[] @relation("SimilarGames")

  @@index([name])
  @@index([releaseDate])
  @@index([createdAt])
  @@index([gameTypeId])
  @@index([esrbRating])
  @@map("games")
}

model GameType {
  id           Int      @id
  label        String
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  Game Game[]

  @@map("game_types")
}

model Genre {
  id           Int      @id
  name         String   @unique
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameGenre")

  @@map("genres")
}

model Theme {
  id           Int      @id
  name         String   @unique
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameTheme")

  @@map("themes")
}

model Platform {
  id               Int      @id
  name             String   @unique
  abbreviation     String
  platformFamilyId Int      @map("platform_family_id")
  igdbChecksum     String   @unique @map("igdb_checksum")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  platformFamily PlatformFamily @relation(fields: [platformFamilyId], references: [id])

  games     Game[]     @relation("GamePlatform")
  userGames UserGame[]

  @@index([platformFamilyId])
  @@map("platforms")
}

model PlatformFamily {
  id           Int      @id
  name         String
  slug         String   @unique
  igdbChecksum String   @unique @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  platforms Platform[]

  @@map("platform_families")
}

model Collection {
  id           Int      @id
  name         String
  igdbChecksum String   @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameCollection")

  @@map("collections")
}

model Franchise {
  id           Int      @id
  name         String
  igdbChecksum String   @map("igdb_checksum")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  games Game[] @relation("GameFranchise")

  @@map("franchises")
}

model TimeToBeat {
  id           Int    @id
  gameId       Int    @unique @map("game_id")
  game         Game   @relation(fields: [gameId], references: [id])
  hastily      Int?
  normally     Int?
  completely   Int?
  count        Int?
  igdbChecksum String @unique @map("igdb_checksum")

  @@index([normally])
  @@map("time_to_beat")
}
