{
  "name": "press-start-server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "postinstall": "prisma generate",
    "start": "prisma migrate deploy && tsx src/server.ts",
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "reset": "npx prisma migrate reset",
    "migrate": "npx prisma migrate dev --create-only",
    "seed": "npx prisma db seed",
    "generate": "npx prisma generate",
    "email:dev": "email dev --dir src/emails"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "author": "Janessa Perry",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.4.2",
    "prisma": "^7.4.2",
    "@react-email/components": "^1.0.12",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.0",
    "resend": "^6.0.1",
    "tsx": "^4.19.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@react-email/ui": "^6.9.2",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.16.0",
    "dotenv": "^16.5.0",
    "eslint": "^9.26.0",
    "express": "^5.1.0",
    "install": "^0.13.0",
    "npm": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.2": true,
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true,
    "prisma@7.9.1": true,
    "sharp@0.34.5": true
  }
}
